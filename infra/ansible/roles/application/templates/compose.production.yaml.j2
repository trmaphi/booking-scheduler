name: booking-scheduler-prod

x-logging: &bounded-logging
  driver: json-file
  options: { max-size: "10m", max-file: "5" }

services:
  postgres:
    image: postgres:16-alpine
    env_file: ["{{ application_environment_file }}"]
    volumes: ["postgres-data:/var/lib/postgresql/data"]
    networks: [data]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 20
    restart: unless-stopped
    logging: *bounded-logging
  migrate:
    image: "{{ api_image }}:{{ release_tag }}"
    entrypoint: ["/usr/local/bin/migrate"]
    env_file: ["{{ application_environment_file }}"]
    environment:
      DATABASE_URL: "${DATABASE_URL}"
    depends_on:
      postgres: { condition: service_healthy }
    networks: [data]
    restart: "no"
    logging: *bounded-logging
  api:
    image: "{{ api_image }}:{{ release_tag }}"
    env_file: ["{{ application_environment_file }}"]
    environment:
      DATABASE_URL: "${DATABASE_URL}"
      ALLOWED_ORIGIN: "https://{{ app_domain }}"
      LISTEN_ADDRESS: ":8080"
    depends_on:
      postgres: { condition: service_healthy }
    networks: [data, app]
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/api/v1/health/ready"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s
    restart: unless-stopped
    logging: *bounded-logging
  web:
    image: "{{ web_image }}:{{ release_tag }}"
    depends_on:
      api: { condition: service_healthy }
    networks: [app]
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:3000/"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 20s
    restart: unless-stopped
    logging: *bounded-logging
  proxy:
    image: caddy:2.10-alpine
    ports: ["80:80", "443:443"]
    volumes:
      - "{{ application_release_dir }}/deploy/Caddyfile:/etc/caddy/Caddyfile:ro"
      - caddy-data:/data
      - caddy-config:/config
    depends_on:
      web: { condition: service_healthy }
      api: { condition: service_healthy }
    networks: [app]
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:2019/config/"]
      interval: 10s
      timeout: 5s
      retries: 12
    restart: unless-stopped
    logging: *bounded-logging
networks:
  app:
  data: { internal: true }
volumes:
  postgres-data:
  caddy-data:
  caddy-config:
