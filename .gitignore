# Source and generated document artifacts must stay outside version control.
*.[pP][dD][fF]

# Local environment and dependency output.
.env
.env.*
!.env.example
node_modules/
.pnpm-store/
.next/
next-env.d.ts
coverage/
playwright-report/
test-results/
*.log
*.tsbuildinfo
.DS_Store

# Optional local additions to the built-in confidentiality detector.
.confidentiality-patterns.local

# Production Ansible values are operator-managed; examples remain tracked.
infra/ansible/group_vars/production.yml
infra/ansible/group_vars/production.vault.yml
infra/ansible/.vault-password
infra/ansible/group_vars/monitoring.yml
infra/ansible/group_vars/monitoring.vault.yml
