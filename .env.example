# Host commands use localhost; Compose containers use postgres:5432 internally.
DATABASE_URL=postgresql://scheduler:scheduler@localhost:55432/scheduler
ALLOWED_ORIGIN=http://localhost:3000
POSTGRES_PORT=55432
API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_INTERNAL_BASE_URL=http://api:8080

# Telemetry uses privacy-safe JSON on stdout and requires no environment values.
# A future exporter can implement the Go telemetry.Recorder interface.

# Set DATABASE_URL to a standard PostgreSQL URL for any other environment.
